{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "seo": {
      "type": "component",
      "component": "meta-components.seo",
      "repeatable": false
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "components.hero-section",
        "components.grid-cards",
        "components.featured-projects"
      ]
    }
  }
}
